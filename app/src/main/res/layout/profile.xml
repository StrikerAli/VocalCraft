<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfileActivity">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profile Setup"
        android:textStyle="bold"
        android:textSize="32sp"
        android:fontFamily="@font/montserrat_bold_italic"
        android:textColor="@android:color/white"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/iconImage" />

    <ImageView
        android:id="@+id/iconImage"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/megaphone" />

    <EditText
        android:id="@+id/companyNameEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Company Name"
        android:textColorHint="@android:color/darker_gray"
        android:background="@drawable/edit_text_boundary"
        android:layout_margin="16dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/iconImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/primaryThemeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Primary Theme:     "
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/companyNameEditText" />

    <View
        android:id="@+id/primaryThemePicker"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@android:color/holo_blue_light"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/companyNameEditText"
        app:layout_constraintStart_toEndOf="@id/primaryThemeLabel" />

    <TextView
        android:id="@+id/secondaryThemeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secondary Theme:"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/primaryThemePicker"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/secondaryThemePicker"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@android:color/holo_orange_light"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/primaryThemePicker"
        app:layout_constraintStart_toEndOf="@id/secondaryThemeLabel" />

    <Button
        android:id="@+id/saveButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Save"
        android:textColor="@android:color/white"
        android:backgroundTint="@android:color/holo_green_dark"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/secondaryThemePicker"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
