<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color of the EditText -->
    <solid android:color="@android:color/white" />

    <!-- Set the corner radius for the rounded edges -->
    <corners android:radius="12dp" />

    <!-- Set a border stroke around the EditText -->
    <stroke
        android:width="2dp"
        android:color="@android:color/darker_gray" />

    <!-- Optional: Set padding inside the EditText -->
    <padding
        android:left="10dp"
        android:right="10dp"
        android:top="5dp"
        android:bottom="5dp" />
</shape>
